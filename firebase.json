{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.txt",
      "password_rank/prep/**",
      "password_rank/output/**",
      "password_rank/themes/**",
      "password_rank/data/x*",
      "password_rank/**/*.py",
      "password_rank/**/__pycache__/**",
      "state-of-the-trail/*.py",
      "state-of-the-trail/engine.test.js",
      "state-of-the-trail/package.json",
      "state-of-the-trail/README.md"
    ],
    "headers": [
      {
        "source": "state-of-the-trail/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
